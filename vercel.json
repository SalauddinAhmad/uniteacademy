{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "installCommand": "bun install",
      "buildCommand": "bun run build"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "installCommand": "bun install",
      "buildCommand": "bun run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}

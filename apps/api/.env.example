# ============================================
# Uniteacademy API — Environment Configuration
# Copy to .env and fill for your cPanel deploy
# ============================================

# --- Server ---
NODE_ENV=production
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=https://uniteacademy.com,https://www.uniteacademy.com

# --- Database (MySQL from cPanel > MySQL Databases) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# On cPanel the host is usually "localhost" and user/db names are prefixed
DATABASE_URL="mysql://cpanelusr_uniteapi:CHANGE_ME@localhost:3306/cpanelusr_unitedb"

# --- JWT / Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_DOMAIN=.uniteacademy.com

# --- File uploads (local disk) ---
# Absolute path recommended. Ensure the folder exists and Node user can write.
UPLOAD_DIR=/home/cpanelusr/uniteacademy-uploads
UPLOAD_MAX_MB=10

# --- Email (Gmail SMTP) ---
# For Gmail: enable 2FA + create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Uniteacademy <no-reply@uniteacademy.com>"

# --- Admin bootstrap (used by seed) ---
ADMIN_EMAIL=admin@uniteacademy.com
ADMIN_PASSWORD=CHANGE_ME_STRONG

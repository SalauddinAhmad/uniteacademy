# ─── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8080

# ─── Database (MySQL) ────────────────────────────────
# cPanel example: mysql://cpaneluser_dbuser:password@localhost:3306/cpaneluser_dbname
DATABASE_URL="mysql://root:password@localhost:3306/uniteacademy"

# ─── Auth ────────────────────────────────────────────
JWT_SECRET="change-me-use-openssl-rand-hex-64"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─── File Uploads ────────────────────────────────────
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads

# ─── SMTP (Gmail) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Uniteacademy <noreply@uniteacademy.com>"

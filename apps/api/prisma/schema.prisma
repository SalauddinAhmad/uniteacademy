// Prisma schema — Uniteacademy
// MySQL 5.7+ / 8.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// AUTH & USERS
// ───────────────────────────────────────────────

enum Role {
  student
  teacher
  admin
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum NoticeAudience {
  all
  students
  teachers
}

enum EventKind {
  class_session
  exam
  holiday
  other
}

enum SubmissionStatus {
  pending
  submitted
  graded
  late
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String?  @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  role           Role     @default(student)
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments    Enrollment[]
  taughtCourses  Course[]     @relation("CourseInstructor")
  submissions    AssignmentSubmission[]
  examAttempts   ExamAttempt[]
  notifications  Notification[]
  payments       Payment[]

  @@index([role])
}

// ───────────────────────────────────────────────
// CATALOG
// ───────────────────────────────────────────────

model Course {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  subtitle        String?  @db.Text
  description     String?  @db.Text
  coverUrl        String?
  level           String?  // beginner / intermediate / advanced
  language        String   @default("bn")
  category        String?  // diploma / talimul_quran / teacher_training / free
  courseType      String?  // live / recorded
  durationWeeks   Int?
  durationMinutes Int?
  totalLessons    Int?
  priceCents      Int      @default(0)
  originalPriceCents Int?
  rating          Float?
  ratingsCount    Int      @default(0)
  isPublished     Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  longDescription String?  @db.Text

  // JSON blobs (rendered on course detail page)
  learningPoints  Json?    // string[]
  requirements    Json?    // string[]
  curriculum      Json?    // [{ title, lessons: [{title, duration}] }]

  instructorId    String?
  instructor      User?    @relation("CourseInstructor", fields: [instructorId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments     Enrollment[]
  assignments     Assignment[]
  exams           Exam[]
  payments        Payment[]
  events          Event[]

  @@index([isPublished, isFeatured])
  @@index([instructorId])
  @@index([category])
}

// ───────────────────────────────────────────────
// PROGRAMS (e.g. Diploma in Islamic Studies)
// ───────────────────────────────────────────────

model Program {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  description  String?  @db.Text
  coverUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]
}

// ───────────────────────────────────────────────
// ENROLLMENTS
// ───────────────────────────────────────────────

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String?
  programId  String?
  isBehind   Boolean  @default(false)
  progress   Int      @default(0) // 0-100
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  program    Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@unique([userId, programId])
  @@index([userId])
}

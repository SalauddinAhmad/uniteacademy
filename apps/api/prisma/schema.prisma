// Prisma schema — Uniteacademy
// MySQL 5.7+ / 8.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// AUTH & USERS
// ───────────────────────────────────────────────

enum Role {
  student
  teacher
  admin
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum NoticeAudience {
  all
  students
  teachers
}

enum EventKind {
  class_session
  exam
  holiday
  other
}

enum SubmissionStatus {
  pending
  submitted
  graded
  late
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String?  @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  role           Role     @default(student)
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments    Enrollment[]
  taughtCourses  Course[]     @relation("CourseInstructor")
  submissions    AssignmentSubmission[]
  examAttempts   ExamAttempt[]
  notifications  Notification[]
  payments       Payment[]

  @@index([role])
}

// ───────────────────────────────────────────────
// CATALOG
// ───────────────────────────────────────────────

model Course {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  subtitle        String?  @db.Text
  description     String?  @db.Text
  coverUrl        String?
  level           String?  // beginner / intermediate / advanced
  language        String   @default("bn")
  category        String?  // diploma / talimul_quran / teacher_training / free
  courseType      String?  // live / recorded
  durationWeeks   Int?
  durationMinutes Int?
  totalLessons    Int?
  priceCents      Int      @default(0)
  originalPriceCents Int?
  rating          Float?
  ratingsCount    Int      @default(0)
  isPublished     Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  longDescription String?  @db.Text

  // JSON blobs (rendered on course detail page)
  learningPoints  Json?    // string[]
  requirements    Json?    // string[]
  curriculum      Json?    // [{ title, lessons: [{title, duration}] }]

  instructorId    String?
  instructor      User?    @relation("CourseInstructor", fields: [instructorId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments     Enrollment[]
  assignments     Assignment[]
  exams           Exam[]
  payments        Payment[]
  events          Event[]

  @@index([isPublished, isFeatured])
  @@index([instructorId])
  @@index([category])
}

// ───────────────────────────────────────────────
// PROGRAMS (e.g. Diploma in Islamic Studies)
// ───────────────────────────────────────────────

model Program {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  description  String?  @db.Text
  coverUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments  Enrollment[]
}

// ───────────────────────────────────────────────
// ENROLLMENTS
// ───────────────────────────────────────────────

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String?
  programId  String?
  isBehind   Boolean  @default(false)
  progress   Int      @default(0) // 0-100
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  program    Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@unique([userId, programId])
  @@index([userId])
}

// ───────────────────────────────────────────────
// ASSIGNMENTS
// ───────────────────────────────────────────────

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?  @db.Text
  dueAt       DateTime?
  points      Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([dueAt])
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  userId       String
  status       SubmissionStatus @default(pending)
  score        Int?
  feedback     String?  @db.Text
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────
// EXAMS
// ───────────────────────────────────────────────

model Exam {
  id           String   @id @default(uuid())
  courseId     String
  title        String
  description  String?  @db.Text
  scheduledAt  DateTime
  durationMin  Int      @default(60)
  totalMarks   Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts     ExamAttempt[]

  @@index([courseId])
  @@index([scheduledAt])
}

model ExamAttempt {
  id          String   @id @default(uuid())
  examId      String
  userId      String
  score       Int?
  status      SubmissionStatus @default(pending)
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────
// NOTICES & NOTIFICATIONS
// ───────────────────────────────────────────────

model Notice {
  id          String   @id @default(uuid())
  title       String
  body        String   @db.Text
  audience    NoticeAudience @default(all)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([audience])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String   @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

// ───────────────────────────────────────────────
// PAYMENTS
// ───────────────────────────────────────────────

model Payment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String?
  amountCents Int
  currency    String   @default("BDT")
  method      String   // bkash, nagad, card, bank
  status      PaymentStatus @default(pending)
  txnId       String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

// ───────────────────────────────────────────────
// EVENTS / CALENDAR
// ───────────────────────────────────────────────

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  startAt     DateTime
  endAt       DateTime?
  courseId    String?
  kind        EventKind @default(other)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([courseId])
}
